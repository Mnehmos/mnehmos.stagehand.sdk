{
  "$comment": "Generated by tools/workspaces.mjs --write from docs/governance/workspaces.json. Do not hand-edit.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@stagehand/core": [
        "packages/core/src"
      ],
      "@stagehand/core/*": [
        "packages/core/src/*"
      ],
      "@stagehand/parser": [
        "packages/parser/src"
      ],
      "@stagehand/parser/*": [
        "packages/parser/src/*"
      ],
      "@stagehand/registry": [
        "packages/registry/src"
      ],
      "@stagehand/registry/*": [
        "packages/registry/src/*"
      ],
      "@stagehand/runtime": [
        "packages/runtime/src"
      ],
      "@stagehand/runtime/*": [
        "packages/runtime/src/*"
      ],
      "@stagehand/trace": [
        "packages/trace/src"
      ],
      "@stagehand/trace/*": [
        "packages/trace/src/*"
      ],
      "@stagehand/readiness": [
        "packages/readiness/src"
      ],
      "@stagehand/readiness/*": [
        "packages/readiness/src/*"
      ],
      "@stagehand/authoring": [
        "packages/authoring/src"
      ],
      "@stagehand/authoring/*": [
        "packages/authoring/src/*"
      ],
      "@stagehand/compatibility-llm-chess": [
        "packages/compatibility/llm-chess/src"
      ],
      "@stagehand/compatibility-llm-chess/*": [
        "packages/compatibility/llm-chess/src/*"
      ],
      "@stagehand/plugin-whiteboard": [
        "plugins/whiteboard/src"
      ],
      "@stagehand/plugin-whiteboard/*": [
        "plugins/whiteboard/src/*"
      ],
      "@stagehand/plugin-geo-clio": [
        "plugins/geo-clio/src"
      ],
      "@stagehand/plugin-geo-clio/*": [
        "plugins/geo-clio/src/*"
      ],
      "@stagehand/plugin-classroom": [
        "plugins/classroom/src"
      ],
      "@stagehand/plugin-classroom/*": [
        "plugins/classroom/src/*"
      ],
      "@stagehand/plugin-chess": [
        "plugins/chess/src"
      ],
      "@stagehand/plugin-chess/*": [
        "plugins/chess/src/*"
      ],
      "@stagehand/plugin-dom-presenter": [
        "plugins/dom-presenter/src"
      ],
      "@stagehand/plugin-dom-presenter/*": [
        "plugins/dom-presenter/src/*"
      ],
      "@stagehand/example-virtual-classroom-host": [
        "examples/virtual-classroom-host/src"
      ],
      "@stagehand/example-virtual-classroom-host/*": [
        "examples/virtual-classroom-host/src/*"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "packages/compatibility/*/src",
    "plugins/*/src",
    "examples/*/src"
  ]
}
